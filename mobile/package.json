{
  "name": "educar-para-transformar-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci && node --test \"scripts/*.test.mjs\"",
    "doctor": "expo-doctor",
    "compartido:sync": "node scripts/sync-compartido.mjs",
    "compartido:check": "node scripts/sync-compartido.mjs --check",
    "verificar:importaciones": "node scripts/verificar-importaciones.mjs",
    "verificar:expo": "expo install --check",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "test:jest": "jest --ci",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "^58.0.14",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}

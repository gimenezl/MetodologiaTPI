{
  "name": "educar-para-transformar-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci && node --test \"scripts/*.test.mjs\"",
    "doctor": "expo-doctor",
    "compartido:sync": "node scripts/sync-compartido.mjs",
    "compartido:check": "node scripts/sync-compartido.mjs --check",
    "verificar:importaciones": "node scripts/verificar-importaciones.mjs",
    "verificar:expo": "expo install --check",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "test:jest": "jest --ci",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
